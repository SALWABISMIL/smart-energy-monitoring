void setupTime() {

  configTime(
    LOCAL_TIMEZONE_OFFSET,
    0,
    "pool.ntp.org",
    "time.nist.gov"
  );
}

String getDateString() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return "Unknown";
  }

  char buffer[20];

  strftime(
    buffer,
    sizeof(buffer),
    "%Y-%m-%d",
    &timeinfo
  );

  return String(buffer);
}

String getTimeString() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return "--:--:--";
  }

  char buffer[20];

  strftime(
    buffer,
    sizeof(buffer),
    "%H:%M:%S",
    &timeinfo
  );

  return String(buffer);
}

int getDayNumber() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return -1;
  }

  return timeinfo.tm_yday;
}

int getMonthNumber() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return -1;
  }

  return timeinfo.tm_mon;
}

// ============================================================
// RELAY
// ============================================================

void setRelay(int pin, bool state) {

  digitalWrite(
    pin,
    state ? RELAY_ON : RELAY_OFF
  );
}

bool getRelay(int pin) {

  return digitalRead(pin) == RELAY_ON;
}

void allRelaysOff() {

  digitalWrite(
    RELAY_AC_PIN,
    RELAY_OFF
  );

  digitalWrite(
    RELAY_HEATER_PIN,
    RELAY_OFF
  );

  digitalWrite(
    RELAY_LIGHTS_PIN,
    RELAY_OFF
  );

  digitalWrite(
    RELAY_SPARE_PIN,
    RELAY_OFF
  );
}

