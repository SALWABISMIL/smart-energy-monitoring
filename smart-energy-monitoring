String getDateString() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return "Unknown";
  }

  char buffer[20];

  strftime(
    buffer,
    sizeof(buffer),
    "%Y-%m-%d",
    &timeinfo
  );

  return String(buffer);
}

String getTimeString() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return "--:--:--";
  }

  char buffer[20];

  strftime(
    buffer,
    sizeof(buffer),
    "%H:%M:%S",
    &timeinfo
  );

  return String(buffer);
}

int getDayNumber() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return -1;
  }

  return timeinfo.tm_yday;
}

int getMonthNumber() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 100)) {
    return -1;
  }

  return timeinfo.tm_mon;
}

// ============================================================
// WEEKDAY
// ============================================================

int getWeekdayFromDate(String date) {

  if (date.length() != 10) {
    return -1;
  }

  int year = date.substring(0, 4).toInt();
  int month = date.substring(5, 7).toInt();
  int day = date.substring(8, 10).toInt();

  if (
    year < 2000 ||
    month < 1 ||
    month > 12 ||
    day < 1 ||
    day > 31
  ) {
    return -1;
  }

  static const int monthTable[] = {
    0, 3, 2, 5, 0, 3,
    5, 1, 4, 6, 2, 4
  };

  int y = year;

  if (month < 3) {
    y -= 1;
  }

  int weekday =
    (
      y +
      y / 4 -
      y / 100 +
      y / 400 +
      monthTable[month - 1] +
      day
    ) % 7;

  return weekday;
}

String getWeekdayName(String date) {

  int weekday = getWeekdayFromDate(date);

  switch (weekday) {

    case 0: return "Sunday";
    case 1: return "Monday";
    case 2: return "Tuesday";
    case 3: return "Wednesday";
    case 4: return "Thursday";
    case 5: return "Friday";
    case 6: return "Saturday";

    default:
      return "-";
  }
}

// ============================================================
// HISTORY DATE INITIALIZATION
// ============================================================

void initializeHistoryDates() {

  time_t now = time(nullptr);

  if (now < 100000) {
    return;
  }

  struct tm currentTm;

  if (!localtime_r(&now, &currentTm)) {
    return;
  }

  String todayDate = getDateString();

  bool validExistingHistory = false;

  for (int i = 0; i < HISTORY_DAYS; i++) {

    if (historyDate[i].length() == 10) {
      validExistingHistory = true;
      break;
    }
  }

  if (!validExistingHistory) {

    for (int i = 0; i < HISTORY_DAYS; i++) {

      time_t dayTime =
        now -
        ((HISTORY_DAYS - 1 - i) * 86400);

      struct tm dayTm;

      if (localtime_r(&dayTime, &dayTm)) {

        char dateBuf[11];

        strftime(
          dateBuf,
          sizeof(dateBuf),
          "%Y-%m-%d",
          &dayTm
        );

        historyDate[i] = String(dateBuf);
        historyEnergy[i] = 0;
      }
    }

    currentHistoryDay = HISTORY_DAYS - 1;

    historyEnergy[currentHistoryDay] =
      dailyEnergyKWh;

    historyDate[currentHistoryDay] =
      todayDate;

    saveEnergyData();

    return;
  }

  // Make sure today's date exists.
  bool todayExists = false;

  for (int i = 0; i < HISTORY_DAYS; i++) {

    if (historyDate[i] == todayDate) {
      currentHistoryDay = i;
      todayExists = true;
      break;
    }
  }

  if (!todayExists) {

    currentHistoryDay++;

    if (currentHistoryDay >= HISTORY_DAYS) {
      currentHistoryDay = 0;
    }

    historyDate[currentHistoryDay] =
      todayDate;

    historyEnergy[currentHistoryDay] =
      dailyEnergyKWh;

    saveEnergyData();
  }
}

