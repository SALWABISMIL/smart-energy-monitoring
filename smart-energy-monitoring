// ============================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "SMART ENERGY SYSTEM"
  );

  Serial.println(
    "CODE 655"
  );

  Serial.println(
    "================================"
  );

  // ----------------------------------------------------------
  // RELAYS
  // ----------------------------------------------------------

  setupRelays();

  // ----------------------------------------------------------
  // LOAD SETTINGS
  // ----------------------------------------------------------

  loadWiFiSettings();
  loadSystemSettings();
  loadDashboardSettings();
  loadEnergyData();

  // ----------------------------------------------------------
  // PZEM SERIAL
  // ----------------------------------------------------------

  PZEMSerial.begin(
    9600,
    SERIAL_8N1,
    PZEM_RX_PIN,
    PZEM_TX_PIN
  );

  // ----------------------------------------------------------
  // TIME
  // ----------------------------------------------------------

  configTime(
    LOCAL_TIMEZONE_OFFSET,
    0,
    "pool.ntp.org",
    "time.nist.gov"
  );

  // ----------------------------------------------------------
  // WIFI
  // ----------------------------------------------------------

  if (!connectToWiFi()) {

    startSetupAP();
  }

  // ----------------------------------------------------------
  // WEB ROUTES
  // ----------------------------------------------------------

  setupRoutes();

  server.begin();

  Serial.println(
    "Web server started."
  );

  // ----------------------------------------------------------
  // CURRENT DATE
  // ----------------------------------------------------------

  String date =
    getDateString();

  if (date.length() > 0) {

    if (currentDate == "") {

      currentDate = date;

      saveEnergyData();
    }
  }

  lastMeterRead = millis();
  lastEnergyIntegration = millis();
  lastSave = millis();
}

// ============================================================
// WIFI RECONNECT
// ============================================================

void maintainWiFi() {

  if (savedSSID.length() == 0) {
    return;
  }

  if (WiFi.status() ==
      WL_CONNECTED) {

    wifiConnected = true;
    return;
  }

  wifiConnected = false;

  unsigned long now =
    millis();

  if (
    now - lastWifiAttempt <
    WIFI_RETRY_MS
  ) {
    return;
  }

  lastWifiAttempt = now;

  Serial.println(
    "Trying Wi-Fi reconnect..."
  );

  WiFi.disconnect();

  WiFi.begin(
    savedSSID.c_str(),
    savedPassword.c_str()
  );
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  server.handleClient();

  maintainWiFi();

  unsigned long now =
    millis();

  // ----------------------------------------------------------
  // READ PZEM
  // ----------------------------------------------------------

  if (
    now - lastMeterRead >=
    READ_INTERVAL_MS
  ) {

    lastMeterRead = now;

    readAllMeters();

    integrateEnergy();

    checkDateChange();

    /*
      TEST MODE:
      Only automatic-saving control uses simulated power.

      PZEM readings themselves remain unchanged.
    */

    if (energySavingTestMode) {

      controlPowerW =
        testPowerW;

    } else {

      controlPowerW =
        totalPowerW;
    }

    energySavingLogic();

    calculateBilling();
  }

  // ----------------------------------------------------------
  // SAVE DATA
  // ----------------------------------------------------------

  if (
    now - lastSave >=
    SAVE_INTERVAL_MS
  ) {

    lastSave = now;

    saveEnergyData();

    saveSystemSettings();
  }

  delay(2);
}
