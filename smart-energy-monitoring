String powerText(float watts) {

  if (!isfinite(watts)) watts = 0;

  if (powerUnit == "W") {
    return String(watts, 0) + " W";
  }

  return String(watts / 1000.0f, 2) + " kW";
}

String energyText(float kWh) {

  if (!isfinite(kWh)) kWh = 0;

  return String(kWh, 2) + " kWh";
}

String moneyText(float value) {

  if (!isfinite(value)) value = 0;

  return String(value, 3);
}

String relayText(bool state) {
  return state ? "ON" : "OFF";
}

