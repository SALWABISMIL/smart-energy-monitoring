// ============================================================
// PZEM ADDRESS COMMISSIONING
// ============================================================

void handlePZEMSet() {

  int target =
    server.arg("address").toInt();

  uint8_t newAddress;

  if (target == 1) {

    newAddress =
      PZEM_AC_ADDRESS;

  } else if (target == 2) {

    newAddress =
      PZEM_HEATER_ADDRESS;

  } else if (target == 3) {

    newAddress =
      PZEM_LIGHTS_ADDRESS;

  } else {

    server.send(
      400,
      "text/plain",
      "Invalid address."
    );

    return;
  }

  /*
    The PZEM library changes the address of the meter
    connected to the serial bus.

    Only ONE PZEM should be connected during commissioning.
  */

  bool result =
    pzemAC.setAddress(newAddress);

  String html =
    htmlHeader("PZEM Result");

  html += "<div class='card'>";

  html += "<div class='section-title'>";
  html += "PZEM COMMISSIONING RESULT";
  html += "</div>";

  if (result) {

    html += "<p>Address successfully changed to:</p>";

    html += "<div class='metric-value'>0x";

    if (newAddress < 16)
      html += "0";

    html += String(
      newAddress,
      HEX
    );

    html += "</div>";

  } else {

    html += "<div class='warning'>";
    html += "Address change failed.";
    html += "</div>";
  }

  html += "<p class='subtitle'>";
  html += "Disconnect this PZEM before commissioning another one.";
  html += "</p>";

  html += "</div>";

  html += htmlFooter();

  server.send(
    200,
    "text/html",
    html
  );
}

