// ============================================================
// WIFI CONNECTION
// ============================================================

bool connectToWiFi() {

  if (savedSSID.length() == 0) {
    return false;
  }

  WiFi.mode(WIFI_STA);

  WiFi.setHostname(HOSTNAME);

  WiFi.begin(
    savedSSID.c_str(),
    savedPassword.c_str()
  );

  Serial.print(
    "Connecting to Wi-Fi"
  );

  unsigned long start =
    millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - start < 15000UL
  ) {

    delay(500);

    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() ==
      WL_CONNECTED) {

    wifiConnected = true;

    Serial.println(
      "Wi-Fi connected."
    );

    Serial.print(
      "IP: "
    );

    Serial.println(
      WiFi.localIP()
    );

    if (MDNS.begin(HOSTNAME)) {

      Serial.print(
        "mDNS: http://"
      );

      Serial.print(
        HOSTNAME
      );

      Serial.println(
        ".local"
      );
    }

    return true;
  }

  wifiConnected = false;

  Serial.println(
    "Wi-Fi connection failed."
  );

  return false;
}

