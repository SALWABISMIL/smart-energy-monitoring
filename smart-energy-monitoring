float safeVoltage(PZEM004Tv30 &meter) {

  float value = meter.voltage();

  if (!isfinite(value)) return 0;

  return value;
}

float safeCurrent(PZEM004Tv30 &meter) {

  float value = meter.current();

  if (!isfinite(value)) return 0;

  return value;
}

float safePower(PZEM004Tv30 &meter) {

  float value = meter.power();

  if (!isfinite(value)) return 0;

  return value;
}

float safeEnergy(PZEM004Tv30 &meter) {

  float value = meter.energy();

  if (!isfinite(value)) return 0;

  return value;
}

void readAllMeters() {

  acVoltage = safeVoltage(pzemAC);
  acCurrent = safeCurrent(pzemAC);
  acPower = safePower(pzemAC);
  acEnergy = safeEnergy(pzemAC);

  heaterVoltage = safeVoltage(pzemHeater);
  heaterCurrent = safeCurrent(pzemHeater);
  heaterPower = safePower(pzemHeater);
  heaterEnergy = safeEnergy(pzemHeater);

  lightsVoltage = safeVoltage(pzemLights);
  lightsCurrent = safeCurrent(pzemLights);
  lightsPower = safePower(pzemLights);
  lightsEnergy = safeEnergy(pzemLights);

  totalPowerW =
    acPower +
    heaterPower +
    lightsPower;

  totalCurrent =
    acCurrent +
    heaterCurrent +
    lightsCurrent;

  highConsumption =
    totalPowerW >= highPowerLimitW;

  Serial.println("-----------------------------");

  Serial.print("AC Power: ");
  Serial.print(acPower, 2);
  Serial.println(" W");

  Serial.print("Heater Power: ");
  Serial.print(heaterPower, 2);
  Serial.println(" W");

