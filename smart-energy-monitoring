void handleDashboard() {

  String html =
    htmlHeader(
      dashboardTitle,
      false
    );

  html += "<div class='grid'>";

  // ==========================================================
  // MAIN POWER
  // ==========================================================

  html += "<div class='card mainpower'>";

  html += "<div class='label'>TOTAL POWER</div>";

  html += "<div id='totalPower' class='power'>";
  html += formatPower(totalPowerW);
  html += "</div>";

  html += "<div id='wifiStatus' class='";

  html += wifiConnected
    ? "online"
    : "warning";

  html += "'>";

  html += wifiConnected
    ? "ONLINE"
    : "SETUP MODE";

  html += "</div>";

  html += "<div id='highStatus' class='danger' style='";

  html += highConsumption
    ? ""
    : "display:none;";

  html += "'>";

  html += "HIGH CONSUMPTION";

  html += "</div>";

  html += "</div>";

  // ==========================================================
  // AC
  // ==========================================================

  if (showAC) {

    html += "<div class='card'>";

    html += "<div class='label'>AC</div>";

    html += "<div id='acPower' class='value'>";
    html += formatPower(acPower);
    html += "</div>";

    if (showVoltage) {

      html += "<div class='small'>";
      html += "Voltage: ";
      html += "<span id='acVoltage'>";
      html += String(acVoltage, 1);
      html += "</span> V";
      html += "</div>";
    }

    if (showCurrent) {

      html += "<div class='small'>";
      html += "Current: ";
      html += "<span id='acCurrent'>";
      html += String(acCurrent, 2);
      html += "</span> A";
      html += "</div>";
    }

    if (showEnergy) {

      html += "<div class='small'>";
      html += "Energy: ";
      html += "<span id='acEnergy'>";
      html += String(acEnergy, 3);
      html += "</span> kWh";
      html += "</div>";
    }

    html += "</div>";
  }

  // ==========================================================
  // HEATER
  // ==========================================================

  if (showHeater) {

    html += "<div class='card'>";

    html += "<div class='label'>HEATER</div>";

    html += "<div id='heaterPower' class='value'>";
    html += formatPower(heaterPower);
    html += "</div>";

    if (showVoltage) {

      html += "<div class='small'>";
      html += "Voltage: ";
      html += "<span id='heaterVoltage'>";
      html += String(heaterVoltage, 1);
      html += "</span> V";
      html += "</div>";
    }

    if (showCurrent) {

      html += "<div class='small'>";
      html += "Current: ";
      html += "<span id='heaterCurrent'>";
      html += String(heaterCurrent, 2);
      html += "</span> A";
      html += "</div>";
    }

    if (showEnergy) {

      html += "<div class='small'>";
      html += "Energy: ";
      html += "<span id='heaterEnergy'>";
      html += String(heaterEnergy, 3);
      html += "</span> kWh";
      html += "</div>";
    }

    html += "</div>";
  }

  // ==========================================================
  // LIGHTS
  // ==========================================================

  if (showLights) {

    html += "<div class='card'>";

    html += "<div class='label'>LIGHTS</div>";

    html += "<div id='lightsPower' class='value'>";
    html += formatPower(lightsPower);
    html += "</div>";

    if (showVoltage) {

      html += "<div class='small'>";
      html += "Voltage: ";
      html += "<span id='lightsVoltage'>";
      html += String(lightsVoltage, 1);
      html += "</span> V";
      html += "</div>";
    }

    if (showCurrent) {

      html += "<div class='small'>";
      html += "Current: ";
      html += "<span id='lightsCurrent'>";
      html += String(lightsCurrent, 2);
      html += "</span> A";
      html += "</div>";
    }

    if (showEnergy) {

      html += "<div class='small'>";
      html += "Energy: ";
      html += "<span id='lightsEnergy'>";
      html += String(lightsEnergy, 3);
      html += "</span> kWh";
      html += "</div>";
    }

    html += "</div>";
  }

  // ==========================================================
  // HISTORY
  // ==========================================================

  if (showHistory) {

    html += "<div class='card history-card'>";

    html += "<div class='history-title'>";

    html += "<div class='label'>";
    html += "7 DAY ENERGY HISTORY";
    html += "</div>";

    html += "<div class='small'>kWh</div>";

    html += "</div>";

    html += "<table class='history-table'>";

    html += "<tr>";
    html += "<th>DAY / DATE</th>";
    html += "<th class='history-energy'>ENERGY</th>";
    html += "</tr>";

    for (int i = 0; i < HISTORY_DAYS; i++) {

      int index =
        (
          currentHistoryDay -
          i +
          HISTORY_DAYS
        ) % HISTORY_DAYS;

      html += "<tr>";

      html += "<td>";

      html += "<span id='historyDay";
      html += String(i);
      html += "' class='history-day'>";

      if (historyDate[index].length() > 0) {
        html += getWeekdayName(historyDate[index]);
      } else {
        html += "-";
      }

      html += "</span>";

      html += "<span id='historyDate";
      html += String(i);
      html += "' class='history-date'>";

      if (historyDate[index].length() > 0) {
        html += historyDate[index];
      }

      html += "</span>";

      html += "</td>";

      html += "<td id='historyEnergy";
      html += String(i);
      html += "' class='history-energy'>";

      html += String(
        historyEnergy[index],
        3
      );

      html += " kWh";

      html += "</td>";

      html += "</tr>";
    }

    html += "</table>";
    html += "</div>";
  }

  // ==========================================================
  // BILLING
  // ==========================================================

  if (showBilling) {

    html += "<div class='card dashboard-small'>";

    html += "<div class='label'>";
    html += "ENERGY & BILLING";
    html += "</div>";

    html += "<div class='small'>Today</div>";

    html += "<div id='dailyEnergy' class='value'>";
    html += String(dailyEnergyKWh, 3);
    html += " kWh";
    html += "</div>";

    html += "<div class='small'>";
    html += "Daily Bill: ";
    html += "<span id='dailyBill'>";
    html += String(dailyBill, 3);
    html += "</span>";
    html += "</div>";

    html += "<div class='small'>This Month</div>";

    html += "<div id='monthlyEnergy' class='value'>";
    html += String(monthlyEnergyKWh, 3);
    html += " kWh";
    html += "</div>";

    html += "<div class='small'>";
    html += "Monthly Bill: ";
    html += "<span id='monthlyBill'>";
    html += String(monthlyBill, 3);
    html += "</span>";
    html += "</div>";

    html += "<div class='small'>";
    html += "Predicted: ";
    html += "<span id='predictedBill'>";
    html += String(predictedMonthlyBill, 3);
    html += "</span>";
    html += "</div>";

    html += "</div>";
  }

  // ==========================================================
  // ENERGY SAVING
  // ==========================================================

  if (showEnergySaving) {

    html += "<div class='card dashboard-small'>";

    html += "<div class='label'>ENERGY SAVING</div>";

    html += "<div id='savingStatus'>";

    if (!relayControlEnabled) {

      html += "<div class='warning'>";
      html += "RELAY CONTROL DISABLED";
      html += "</div>";

    } else if (energySavingActive) {

      html += "<div class='danger'>";
      html += "ENERGY SAVING ACTIVE";
      html += "</div>";

      html += "<div class='small'>";
      html += "Heater automatically OFF";
      html += "</div>";

      if (!energySavingTestMode) {

        html += "<div class='small'>";
        html += "Estimated saving: ";
        html += "<span id='savedPower'>";
        html += String(savedPowerW, 0);
        html += "</span> W";
        html += "</div>";
      }

    } else {

      html += "<div class='online'>";
      html += "NORMAL";
      html += "</div>";
    }

    if (energySavingTestMode) {

      html += "<div class='small'>";
      html += "TEST MODE: ";
      html += "<span id='testPower'>";
      html += String(testPowerW, 0);
      html += "</span> W";
      html += "</div>";
    }

    html += "</div>";
    html += "</div>";
  }

  // ==========================================================
  // SYSTEM STATUS
  // ==========================================================

  html += "<div class='card dashboard-small'>";

  html += "<div class='label'>SYSTEM STATUS</div>";

  html += "<div class='small'>";
  html += "Date: ";
  html += "<span id='systemDate'>";
  html += getDateString();
  html += "</span>";
  html += "</div>";

  html += "<div class='small'>";
  html += "Time: ";
  html += "<span id='systemTime'>";
  html += getTimeString();
  html += "</span>";
  html += "</div>";

  html += "<div class='small'>";
  html += "Tariff: ";
  html += "<span id='systemTariff'>";
  html += String(tariff, 3);
  html += "</span>";
  html += "</div>";

  html += "<div class='small'>";
  html += "High limit: ";
  html += "<span id='highLimit'>";
  html += String(highPowerLimitW, 0);
  html += "</span> W";
  html += "</div>";

  html += "</div>";

  html += "</div>";

  // ==========================================================
  // LIVE DASHBOARD JAVASCRIPT
  // ==========================================================

  html += "<script>";

  html += "const refreshMs=";
  html += String(refreshSeconds * 1000);
  html += ";";

  html += "function powerText(w){";
  html += "w=Number(w)||0;";
  html += "return '";
  html += powerUnit;
  html += "'==='W' ? Math.round(w)+' W' : (w/1000).toFixed(2)+' kW';";
  html += "}";

  html += "function setText(id,value){";
  html += "const e=document.getElementById(id);";
  html += "if(e)e.textContent=value;";
  html += "}";

  html += "async function updateDashboard(){";

  html += "try{";

  html +=
    "const r=await fetch('/api',{cache:'no-store'});";

  html += "if(!r.ok)return;";

  html += "const d=await r.json();";

  // Power
  html +=
    "setText('totalPower',powerText(d.totalPowerW));";

  html +=
    "setText('acPower',powerText(d.acPower));";

  html +=
    "setText('heaterPower',powerText(d.heaterPower));";

  html +=
    "setText('lightsPower',powerText(d.lightsPower));";

  // Voltage
  html +=
    "setText('acVoltage',Number(d.acVoltage).toFixed(1));";

  html +=
    "setText('heaterVoltage',Number(d.heaterVoltage).toFixed(1));";

  html +=
    "setText('lightsVoltage',Number(d.lightsVoltage).toFixed(1));";

  // Current
  html +=
    "setText('acCurrent',Number(d.acCurrent).toFixed(2));";

  html +=
    "setText('heaterCurrent',Number(d.heaterCurrent).toFixed(2));";

  html +=
    "setText('lightsCurrent',Number(d.lightsCurrent).toFixed(2));";

  // Energy
  html +=
    "setText('acEnergy',Number(d.acEnergy).toFixed(3));";

  html +=
    "setText('heaterEnergy',Number(d.heaterEnergy).toFixed(3));";

  html +=
    "setText('lightsEnergy',Number(d.lightsEnergy).toFixed(3));";

  // Billing
  html +=
    "setText('dailyEnergy',Number(d.dailyEnergy).toFixed(3)+' kWh');";

  html +=
    "setText('monthlyEnergy',Number(d.monthlyEnergy).toFixed(3)+' kWh');";

  html +=
    "setText('dailyBill',Number(d.dailyBill).toFixed(3));";

  html +=
    "setText('monthlyBill',Number(d.monthlyBill).toFixed(3));";

  html +=
    "setText('predictedBill',Number(d.predictedBill).toFixed(3));";

  // System
  html +=
    "setText('systemDate',d.date);";

  html +=
    "setText('systemTime',d.time);";

  html +=
    "setText('systemTariff',Number(d.tariff).toFixed(3));";

  html +=
    "setText('highLimit',Number(d.highPowerLimitW).toFixed(0));";

  // WiFi
  html +=
    "const ws=document.getElementById('wifiStatus');";

  html += "if(ws){";

  html +=
    "ws.textContent=d.wifiConnected?'ONLINE':'SETUP MODE';";

  html +=
    "ws.className=d.wifiConnected?'online':'warning';";

  html += "}";

  // High consumption
  html +=
    "const hs=document.getElementById('highStatus');";

  html += "if(hs){";

  html +=
    "hs.style.display=d.highConsumption?'block':'none';";

  html += "}";

  // Energy saving
  html +=
    "const ss=document.getElementById('savingStatus');";

  html += "if(ss){";

  html += "let s='';";

  html +=
    "if(!d.relayControl){";

  html +=
    "s=\"<div class='warning'>RELAY CONTROL DISABLED</div>\";";

  html += "}else if(d.energySaving){";

  html +=
    "s=\"<div class='danger'>ENERGY SAVING ACTIVE</div>\";";

  html +=
    "s+=\"<div class='small'>Heater automatically OFF</div>\";";

  html +=
    "if(!d.testMode)s+=\"<div class='small'>Estimated saving: \"+Number(d.savedPowerW).toFixed(0)+\" W</div>\";";

  html += "}else{";

  html +=
    "s=\"<div class='online'>NORMAL</div>\";";

  html += "}";

  html +=
    "if(d.testMode)s+=\"<div class='small'>TEST MODE: \"+Number(d.testPowerW).toFixed(0)+\" W</div>\";";

  html +=
    "ss.innerHTML=s;";

  html += "}";

  // History
  html +=
    "if(d.history){";

  html += "for(let i=0;i<7;i++){";

  html +=
    "setText('historyDay'+i,d.history[i].day);";

  html +=
    "setText('historyDate'+i,d.history[i].date);";

  html +=
    "setText('historyEnergy'+i,Number(d.history[i].energy).toFixed(3)+' kWh');";

  html += "}";

  html += "}";

  html += "}catch(e){";

  html += "console.log('Dashboard update error',e);";

  html += "}";

  html += "}";

  html += "updateDashboard();";

  html += "setInterval(updateDashboard,refreshMs);";

  html += "</script>";

  html += htmlFooter();

  server.send(
    200,
    "text/html",
    html
  );
}

