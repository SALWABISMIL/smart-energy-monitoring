// ============================================================

void handlePZEMSet() {

  if (!server.hasArg("address")) {

    server.send(
      400,
      "text/plain",
      "Address missing"
    );

    return;
  }

  int newAddress =
    server.arg(
      "address"
    ).toInt();

  if (
    newAddress < 1 ||
    newAddress > 247
  ) {

    server.send(
      400,
      "text/plain",
      "Invalid address"
    );

    return;
  }

  /*
     IMPORTANT:
     Only ONE PZEM should be connected.

     The currently connected PZEM is
     programmed using pzemAC.
  */

  bool result =
    pzemAC.setAddress(
      (uint8_t)newAddress
    );

  String html =
    htmlHeader(
      "PZEM Result"
    );

  html += "<div class='card'>";

  if (result) {

    html +=
      "<h2 class='online'>ADDRESS SET SUCCESSFULLY</h2>";

  } else {

    html +=
      "<h2 class='danger'>ADDRESS SET FAILED</h2>";
  }

  html +=
    "<p>New address: 0x";

  html += String(
    newAddress,
    HEX
  );

  html += "</p>";

  html +=
    "<a class='btn' href='/pzem'>BACK</a>";

  html += "</div>";

  html += htmlFooter();

  server.send(
    200,
    "text/html",
    html
  );
}

