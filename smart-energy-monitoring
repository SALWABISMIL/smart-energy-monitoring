  String json = "{";

  json += "\"totalPowerW\":";
  json += String(totalPowerW, 2);

  json += ",\"acPower\":";
  json += String(acPower, 2);

  json += ",\"acVoltage\":";
  json += String(acVoltage, 1);

  json += ",\"acCurrent\":";
  json += String(acCurrent, 2);

  json += ",\"acEnergy\":";
  json += String(acEnergy, 3);

  json += ",\"heaterPower\":";
  json += String(heaterPower, 2);

  json += ",\"heaterVoltage\":";
  json += String(heaterVoltage, 1);

  json += ",\"heaterCurrent\":";
  json += String(heaterCurrent, 2);

  json += ",\"heaterEnergy\":";
  json += String(heaterEnergy, 3);

  json += ",\"lightsPower\":";
  json += String(lightsPower, 2);

  json += ",\"lightsVoltage\":";
  json += String(lightsVoltage, 1);

  json += ",\"lightsCurrent\":";
  json += String(lightsCurrent, 2);

  json += ",\"lightsEnergy\":";
  json += String(lightsEnergy, 3);

  json += ",\"dailyEnergy\":";
  json += String(dailyEnergyKWh, 3);

  json += ",\"monthlyEnergy\":";
  json += String(monthlyEnergyKWh, 3);

  json += ",\"dailyBill\":";
  json += String(dailyBill, 3);

  json += ",\"monthlyBill\":";
  json += String(monthlyBill, 3);

  json += ",\"predictedBill\":";
  json += String(predictedMonthlyBill, 3);

  json += ",\"energySaving\":";
  json += energySavingActive ? "true" : "false";

  json += ",\"relayControl\":";
  json += relayControlEnabled ? "true" : "false";

  json += ",\"testMode\":";
  json += energySavingTestMode ? "true" : "false";

  json += ",\"highConsumption\":";
  json += highConsumption ? "true" : "false";

  json += ",\"wifiConnected\":";
  json += wifiConnected ? "true" : "false";

  json += ",\"savedPowerW\":";
  json += String(savedPowerW, 0);

  json += ",\"testPowerW\":";
  json += String(testPowerW, 0);

  json += ",\"tariff\":";
  json += String(tariff, 3);

  json += ",\"highPowerLimitW\":";
  json += String(highPowerLimitW, 0);

  json += ",\"date\":\"";
  json += getDateString();
  json += "\"";

  json += ",\"time\":\"";
  json += getTimeString();
  json += "\"";

  // ==========================================================
  // HISTORY
  // ==========================================================

  json += ",\"history\":[";

  for (int i = 0; i < HISTORY_DAYS; i++) {

    int index =
      (
        currentHistoryDay -
        i +
        HISTORY_DAYS
      ) % HISTORY_DAYS;

    if (i > 0) {
      json += ",";
    }

    json += "{";

    json += "\"day\":\"";

    if (historyDate[index].length() > 0) {
      json += getWeekdayName(
        historyDate[index]
      );
    } else {
      json += "-";
    }

    json += "\"";

    json += ",\"date\":\"";
    json += historyDate[index];
    json += "\"";

    json += ",\"energy\":";
    json += String(
      historyEnergy[index],
      3
    );

    json += "}";
  }

  json += "]";

  json += "}";

  server.send(
    200,
    "application/json",
    json
  );
}

