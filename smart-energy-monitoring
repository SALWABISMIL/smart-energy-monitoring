void loadEnergyData() {

  preferences.begin("energy", true);

  totalTodayEnergy =
    preferences.getFloat("today", 0);

  totalMonthEnergy =
    preferences.getFloat("month", 0);

  currentDate =
    preferences.getString("date", "");

  for (int i = 0; i < HISTORY_DAYS; i++) {

    String keyE = "e" + String(i);
    String keyD = "d" + String(i);

    historyEnergy[i] =
      preferences.getFloat(keyE.c_str(), 0);

    historyDate[i] =
      preferences.getString(keyD.c_str(), "");
  }

  preferences.end();
}

void saveEnergyData() {

  preferences.begin("energy", false);

  preferences.putFloat("today", totalTodayEnergy);
  preferences.putFloat("month", totalMonthEnergy);
  preferences.putString("date", currentDate);

  for (int i = 0; i < HISTORY_DAYS; i++) {

    String keyE = "e" + String(i);
    String keyD = "d" + String(i);

    preferences.putFloat(keyE.c_str(), historyEnergy[i]);
    preferences.putString(keyD.c_str(), historyDate[i]);
  }

  preferences.end();
}

// ============================================================
// TIME
// ============================================================

String getDateString() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 1000)) {
    return "";
  }

  char buffer[16];

  strftime(buffer, sizeof(buffer), "%Y-%m-%d", &timeinfo);

  return String(buffer);
}

int getCurrentDayOfMonth() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 1000)) {
    return 1;
  }

  return timeinfo.tm_mday;
}

int getDaysInCurrentMonth() {

  struct tm timeinfo;

  if (!getLocalTime(&timeinfo, 1000)) {
    return 30;
  }

  int month = timeinfo.tm_mon + 1;
  int year = timeinfo.tm_year + 1900;

  if (month == 2) {

    bool leap =
      ((year % 4 == 0 && year % 100 != 0) ||
       (year % 400 == 0));

    return leap ? 29 : 28;
  }

  if (month == 4 ||
      month == 6 ||
      month == 9 ||
      month == 11) {

    return 30;
  }

  return 31;
}

// ============================================================
// DAILY / MONTHLY DATE MANAGEMENT
// ============================================================

void checkDateChange() {

  String newDate = getDateString();

  if (newDate == "") {
    return;
  }

  if (currentDate == "") {

    currentDate = newDate;
    saveEnergyData();

    return;
  }

  if (newDate != currentDate) {

    // Shift history
    for (int i = HISTORY_DAYS - 1; i > 0; i--) {

      historyEnergy[i] = historyEnergy[i - 1];
      historyDate[i] = historyDate[i - 1];
    }

    historyEnergy[0] = totalTodayEnergy;
    historyDate[0] = currentDate;

    totalTodayEnergy = 0;

    currentDate = newDate;

    saveEnergyData();

    Serial.println("New day detected.");
  }
}

