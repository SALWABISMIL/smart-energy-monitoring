// ============================================================
// ENERGY INTEGRATION
// ============================================================

void integrateEnergy() {

  unsigned long now = millis();

  if (lastEnergyIntegration == 0) {

    lastEnergyIntegration = now;
    return;
  }

  unsigned long elapsedMs =
    now - lastEnergyIntegration;

  lastEnergyIntegration = now;

  if (elapsedMs > 60000UL) {
    return;
  }

  float hours =
    elapsedMs / 3600000.0f;

  float addedKWh =
    (totalPowerW / 1000.0f) * hours;

  if (addedKWh < 0) {
    addedKWh = 0;
  }

  totalTodayEnergy += addedKWh;
  totalMonthEnergy += addedKWh;
}

// ============================================================
// BILLING
// ============================================================

void calculateBilling() {

  todayCost =
    totalTodayEnergy * tariff;

  monthCost =
    totalMonthEnergy * tariff;

  int day =
    getCurrentDayOfMonth();

  int days =
    getDaysInCurrentMonth();

  if (day > 0 && totalMonthEnergy > 0) {

    float dailyAverage =
      totalMonthEnergy / day;

    float predictedEnergy =
      dailyAverage * days;

    predictedMonthCost =
      predictedEnergy * tariff;

  } else {

    predictedMonthCost = 0;
  }
}

// ============================================================
// HISTORY TOTAL
// ============================================================

float sevenDayEnergy() {

  float total = totalTodayEnergy;

  for (int i = 0; i < HISTORY_DAYS; i++) {
    total += historyEnergy[i];
  }

  return total;
}

// ============================================================
// RELAY CONTROL
// ============================================================

void writeRelay(int pin, bool state) {

  digitalWrite(
    pin,
    state ? RELAY_ON : RELAY_OFF
  );
}

void allRelaysOff() {

  relayACState = false;
  relayHeaterState = false;
  relayLightsState = false;
  relaySpareState = false;

  writeRelay(RELAY_AC_PIN, false);
  writeRelay(RELAY_HEATER_PIN, false);
  writeRelay(RELAY_LIGHTS_PIN, false);
  writeRelay(RELAY_SPARE_PIN, false);
}

void setRelay(int pin, bool state) {

  if (!relayControlEnabled) {
    return;
  }

  writeRelay(pin, state);

  if (pin == RELAY_AC_PIN)
    relayACState = state;

  if (pin == RELAY_HEATER_PIN)
    relayHeaterState = state;

  if (pin == RELAY_LIGHTS_PIN)
    relayLightsState = state;

  if (pin == RELAY_SPARE_PIN)
    relaySpareState = state;
}

// ============================================================
// AUTO ENERGY SAVING
// ============================================================

void energySavingLogic() {

  if (!relayControlEnabled) {

    energySavingActive = false;
    savedPowerW = 0;
    savingBaselinePowerW = 0;

    return;
  }

  // ----------------------------------------------------------
  // HIGH POWER
  // ----------------------------------------------------------

  if (controlPowerW >= energySaveOnW &&
      !energySavingActive) {

    energySavingActive = true;

    savingBaselinePowerW =
      controlPowerW;

    setRelay(
      RELAY_HEATER_PIN,
      false
    );

    heaterWasAutomaticallyOff = true;

    Serial.println(
      "ENERGY SAVING: Heater OFF"
    );
  }

  // ----------------------------------------------------------
  // RETURN TO NORMAL
  // ----------------------------------------------------------

  else if (controlPowerW <= energySaveOffW &&
           energySavingActive) {

    energySavingActive = false;

    savedPowerW = 0;

    savingBaselinePowerW = 0;

    heaterWasAutomaticallyOff = false;

    /*
      Important:
      Heater is NOT automatically turned ON.

      This is intentional for safety.
      User can manually turn it ON again.
    */

    Serial.println(
      "ENERGY SAVING: Normal"
    );
  }

  // ----------------------------------------------------------
  // ESTIMATE REAL SAVING
  // ----------------------------------------------------------

  if (energySavingActive &&
      !energySavingTestMode &&
      savingBaselinePowerW > 0) {

    savedPowerW =
      max(
        0.0f,
        savingBaselinePowerW - totalPowerW
      );

  } else {

    savedPowerW = 0;
  }
}

